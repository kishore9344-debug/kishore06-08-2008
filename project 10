#include <stdio.h>
int main()
{
    int choice=2;
    switch(choice)
    {
        case 1:
        printf("MONDAY");
        break;
        case 2:
        printf("TUESDAY");
        break;
        case 3:
        printf("WEDNESDAY");
        break;
        default:
          printf("Invalid Choice");
    }
    return 0;
}
